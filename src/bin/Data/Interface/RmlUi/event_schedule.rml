<rml>
<head>
	<title>Events</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="event_schedule.rcss"/>
	<link type="text/template" href="window_shell.rml"/>
</head>
<!-- MU Volta: the event schedule on the H key (CEventScheduleWindow), in the shared window frame (window_shell.rml)
     like the options window: screen-centered, dragged by any part that is not a control, closed with its button, Esc
     or H. A countdown per event, then today's starts in local time. -->
<body template="window_shell" data-model="event_schedule">
	<div class="es-lines">
		<div class="es-line" data-for="line : lines"
		     data-class-heading="line.heading" data-class-spacer="line.half_spacer">{{line.text}}</div>
	</div>
	<div class="es-button-row">
		<div class="btn es-close-btn" data-event-click="event_schedule_close">{{close_label}}</div>
	</div>
</body>
</rml>
